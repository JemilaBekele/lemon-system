generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}
enum Status {
  Active
  Inactive
  Suspended
}

model User {
  id          String      @id @default(uuid()) @map("_id") @db.Char(36)
  name        String            @map("name")
  phone       String?     @map("phone")
  userCode    String? 
  email       String      @unique
  admin       Boolean     @default(false)
  password    String
  branchId    String?
  branch      Branch?      @relation(fields: [branchId], references: [id])
  roleId      String      @db.Char(36)
  role        Role        @relation(fields: [roleId], references: [id])
  status      Status      @default(Active) 
   // ✅ A user can be assigned to many shops
  shops       Shop[]   @relation("UserShops")

  // ✅ A user can be assigned to many stores
  stores      Store[]  @relation("UserStores")     // <-- Enum status field replacing isActive
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")
lastLoginAt DateTime?    @default(now())
  @@map("users")
Log Log[]
StockLedger StockLedger[]
CreatorPurchase Purchase[] @relation(name: "creator")
UpdatedPurchase Purchase[] @relation("UpdatedCheckEntrance")
CreatedTransfer Transfer[] @relation("createdTransfer")
UpdatedTransfer Transfer[] @relation("UpdatedTransfer")
StockCorrection StockCorrection[] @relation("createdStockCorrection")
UpdateStockCorrection StockCorrection[] @relation("updatedStockCorrection")
Sell Sell[] @relation("CreatedSale")
UpdateSell Sell[] @relation("UpdatedSale")
SellStockCorrection SellStockCorrection[] @relation("createdSellStockCorrection")
UpdateSellStockCorrection SellStockCorrection[] @relation("updatedSellStockCorrection")
AllAddToCart AddToCart[]
CreatedAddToCart AddToCart[] @relation("CreatedCart")
AddToCart AddToCart[] @relation("UpdatedCart")
waitlists Waitlist[]
waitlistsCreated Waitlist[] @relation("CreatedWaitlist")
waitlistsUpdated Waitlist[] @relation("UpdatedWaitlist")
  convertedOnlineOrders OnlineOrder[] @relation("ConvertedOnlineOrders")
}

model Role {
  id          String @id @default(uuid()) @map("_id") @db.Char(36)
  name        String           @unique @db.VarChar(100)
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  permissions RolePermission[]
  users       User[]
}

model Permission {
  id          String @id @default(uuid()) @map("_id") @db.Char(36)
  name        String           @unique @db.VarChar(100)
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  roles       RolePermission[]
}

model RolePermission {
  id          String @id @default(uuid()) @map("_id") @db.Char(36)
  roleId       String      @db.Char(36)
  permissionId String      @db.Char(36)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  permission   Permission @relation(fields: [permissionId], references: [id])
  role         Role       @relation(fields: [roleId], references: [id])

  @@unique([roleId, permissionId])
}


model Company {
  id          String       @id @default(uuid()) @map("_id") @db.Char(36)
  name        String
  email       String?      @unique
  phone       String?
  address String? // Optional field
  description String?
  tinAddress String? 
  TIN String? 
  From String? 
  logo String?
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  @@map("companies")
}



model Branch {
  id          String @id @default(uuid()) @map("_id") @db.Char(36)
  name        String
  address     String?
  phone       String?  @map("phone") // e.g., +88 05454 6446
  email       String?  @map("email") // e.g., example@example.com
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("branches")
  Shop Shop[]
  Store Store[]
  User User[]
  Sell Sell[]
  AddToCart AddToCart[]
  waitlists Waitlist[]
}


model Shop {
  id          String @id @default(uuid()) @map("_id") @db.Char(36)
  name        String
  branchId    String
  branch      Branch   @relation(fields: [branchId], references: [id])
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("shops")
  ShopStock ShopStock[]
  StockLedger StockLedger[]
  SourceTransfer Transfer[] @relation("TransferSourceShop")
  DestinatTransfer Transfer[] @relation("TransferDestinationShop")
  StockCorrection StockCorrection[]
  AdditionalPrice AdditionalPrice[]
  SellItem SellItem[]
  SellStockCorrectionItem SellStockCorrectionItem[]
  User User[] @relation("UserShops")
  CartItem CartItem[]
  waitlists Waitlist[]
  notifications Notification[]
  onlineOrderItems OnlineOrderItem[]
}

model Store {
  id          String @id @default(uuid()) @map("_id") @db.Char(36)
  name        String
  branchId    String
  branch      Branch   @relation(fields: [branchId], references: [id])
  
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("stores")
  ProductBatch ProductBatch[]
  StoreStock StoreStock[]
  StockLedger StockLedger[]
  Purchase Purchase[]
  SourceTransfer Transfer[] @relation("TransferSourceStore")
  DestinatTransfer Transfer[] @relation("TransferDestinationStore")
  StockCorrection StockCorrection[]
  User User[] @relation("UserStores")
  notifications Notification[]
}
model StoreStock {
  id          String        @id @default(uuid()) @map("_id") @db.Char(36)
  storeId     String        @db.Char(36)
  store       Store         @relation(fields: [storeId], references: [id])
  batchId     String
  batch       ProductBatch  @relation(fields: [batchId], references: [id])
  quantity    Int
  status      StockStatus   @default(Available)

  // ✅ Link directly to a single unit of measure
  unitOfMeasureId String
  unitOfMeasure   UnitOfMeasure @relation(fields: [unitOfMeasureId], references: [id])
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([storeId, batchId])
  @@map("store_stocks")
}
enum StockStatus {
  Available
  Reserved
  Sold
  Damaged
  Returned
  Disposed
}

model ShopStock {
  id          String        @id @default(uuid()) @map("_id") @db.Char(36)
  shopId      String        @db.Char(36)
  shop        Shop          @relation(fields: [shopId], references: [id])
  batchId     String
  batch       ProductBatch  @relation(fields: [batchId], references: [id])
  
  // ✅ Link directly to a single unit of measure
  unitOfMeasureId String
  unitOfMeasure   UnitOfMeasure @relation(fields: [unitOfMeasureId], references: [id])
  quantity    Int
  status      StockStatus   @default(Available)

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([shopId, batchId])
  @@map("shop_stocks")
}
model StockLedger {
  id          String            @id @default(uuid()) @map("_id") @db.Char(36)
  invoiceNo      String?          @unique                 // Invoice number

  batchId     String
  batch       ProductBatch      @relation(fields: [batchId], references: [id])

  storeId     String?           @db.Char(36)
  store       Store?            @relation(fields: [storeId], references: [id], onDelete: Restrict)

  shopId      String?           @db.Char(36)
  shop        Shop?             @relation(fields: [shopId], references: [id], onDelete: Restrict)

  movementType StockMovementType
  quantity     Int


  // ✅ Link directly to a single unit of measure
  unitOfMeasureId String
  unitOfMeasure   UnitOfMeasure @relation(fields: [unitOfMeasureId], references: [id])
  reference    String?           // invoice, purchase order, transfer ref
  // Document that caused this movement (reversals point at the same document)
  sourceType   LedgerSourceType?
  sourceId     String?           @db.Char(36)
  userId       String?           @db.Char(36)
  user         User?             @relation(fields: [userId], references: [id])

  notes        String?

  movementDate DateTime @default(now())
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([sourceType, sourceId])
  @@index([batchId, movementDate])
  @@index([storeId, movementDate])
  @@index([shopId, movementDate])
  @@map("stock_ledgers")
}

enum LedgerSourceType {
  PURCHASE
  TRANSFER
  SALE
  STOCK_CORRECTION
  SELL_CORRECTION
  OPENING_STOCK
}
enum StockMovementType {
  IN          // purchase, stock in
  OUT         // sales, consumption
  TRANSFER    // store → shop, shop → store
  ADJUSTMENT  // manual corrections
  RETERN
}

model Log {
  id        String      @id @default(uuid()) @map("_id") @db.Char(36)
  action    String          @db.VarChar(1000)                    // e.g., "Added 50", "Transferred 20", "Sold 5"
  userId    String?      @db.Char(36)
  user      User?        @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("stock_logs")
}

model Customer {
  id         String   @id @default(uuid()) @map("_id") @db.Char(36)
  name       String   @map("first_name")
    companyName   String?         @db.VarChar(255)
  phone1     String   @map("phone1")
  phone2     String?  @map("phone2")   // optional second phone
  tinNumber  String?  @db.VarChar(100)
  address    String?
  // E-commerce customer id, set when an online order brought this customer in
  externalCustomerId String? @unique @map("external_customer_id") @db.VarChar(64)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("customers")
  Sell       Sell[]
  AddToCart AddToCart[]
  waitlists Waitlist[]
  onlineOrders OnlineOrder[]
}



model Supplier {
  id            String          @id @default(uuid()) @map("_id")  @db.Char(36)
  name          String          @db.VarChar(255)
  contactName   String?         @db.VarChar(255)
  phone         String?         @db.VarChar(50)
  email         String?         @db.VarChar(255)
  address       String?
  city          String?         @db.VarChar(100)
  country       String?         @db.VarChar(100)
  tinNumber     String?         @db.VarChar(100)
  notes         String?
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  @@map("suppliers")
  Purchase Purchase[]
}


model Category {
  id            String            @id @default(uuid()) @map("_id") @db.Char(36)
  name          String
  
  code          String?          @unique 
   image         String?
  isActive      Boolean        @default(true)
  displayOrder  Int            @default(0)                     // e.g., CAT001
  products      Product[]
  subCategories SubCategory[]  // 👈 one-to-many relation

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  
@@map("categories") // Add this line if your table is actually called 'categories'
}
model SubCategory {
  id          String      @id @default(uuid()) @map("_id") @db.Char(36) // SL (serial number)
  name        String     
                              // Sub category name (e.g., Vitamin, Antibiotics)
   code          String? @unique 
  image         String?
  isActive      Boolean        @default(true)
  displayOrder  Int            @default(0)  
  // Relation to Category
  categoryId  String
  category    Category  @relation(fields: [categoryId], references: [id])

  products    Product[]                             // Relation to products if needed

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
    @@map("subcategory") // This maps to the actual table name 'subcategory'

}

model Product {
  id            String         @id @default(uuid()) @map("_id") @db.Char(36)

  productCode   String         @unique                       // e.g., PRD001
  name          String
  generic           String?
  description   String?
  categoryId    String
  category      Category       @relation(fields: [categoryId], references: [id])

  subCategoryId String?
  subCategory   SubCategory?   @relation(fields: [subCategoryId], references: [id])
  sellPrice       Decimal?        @db.Decimal(14, 2)
  // Price shown and charged in the e-commerce shop (null = not set yet)
  ecommercePrice  Decimal?        @map("ecommerce_price") @db.Decimal(14, 2)
  warningQuantity Int            @default(0)   // low-stock threshold for the whole product (all batches)

  imageUrl      String
  

  // ✅ Link directly to a single unit of measure
  unitOfMeasureId String
  unitOfMeasure   UnitOfMeasure @relation(fields: [unitOfMeasureId], references: [id])

  batches       ProductBatch[]  // 👈 Each product can have multiple batches
  isActive            Boolean             @default(true)  // true = active, false = inactive

  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  @@map("products")
  PurchaseItem  PurchaseItem[]
  TransferItem  TransferItem[]
  StockCorrectionItem StockCorrectionItem[]
  CartItem CartItem[]
  AdditionalPrice AdditionalPrice[]
  SellItem SellItem[]
  SellStockCorrectionItem SellStockCorrectionItem[]
  waitlists Waitlist[]
  subProducts SubProduct[]
  onlineOrderItems OnlineOrderItem[]
}
model SubProduct {
  id        String   @id @default(uuid()) @map("_id") @db.Char(36)

  name      String  
  subProductCode   String         @unique                       // e.g., PRD001              // Sub-product name (e.g. Small, Large, Vanilla)
  imageUrl String                     // Image of the sub-product
  sellPrice       Decimal?        @db.Decimal(14, 2)
  // Price shown and charged in the e-commerce shop (null = not set yet)
  ecommercePrice  Decimal?        @map("ecommerce_price") @db.Decimal(14, 2)

  productId String   @db.Char(36)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  isActive  Boolean  @default(true)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("sub_products")
  productBatches ProductBatch[]
  purchaseItems PurchaseItem[]
  transferItems TransferItem[]
  stockCorrectionItems StockCorrectionItem[]
  sellItems SellItem[]
  cartItems CartItem[]
  sellStockCorrectionItems SellStockCorrectionItem[]
  additionalPrices AdditionalPrice[]
  onlineOrderItems OnlineOrderItem[]
}

model UnitOfMeasure {
  id       String     @id @default(uuid()) @map("_id") @db.Char(36)
  name     String     @unique
  symbol   String?
  base     Boolean    @default(false)

  // ✅ Back relation to products
  products Product[]

  PurchaseItem PurchaseItem[]

  TransferItem TransferItem[]

  StockLedger StockLedger[]

  ShopStock ShopStock[]

  StoreStock StoreStock[]

  StockCorrectionItem StockCorrectionItem[]

  SellItem SellItem[]

  SellStockCorrectionItem SellStockCorrectionItem[]
    @@map("unitofmeasure") // This maps to the actual table name 'unitofmeasure'

  CartItem CartItem[]
}
model AdditionalPrice {
  id         String      @id @default(uuid()) @map("_id") @db.Char(36)
  label      String?
  price      Decimal @db.Decimal(14, 2)
    productId       String       @db.Char(36)
  product         Product      @relation(fields: [productId], references: [id])
 subProductId    String?      @db.Char(36)
  subProduct      SubProduct?  @relation(fields: [subProductId], references: [id])

  shopId      String?        @db.Char(36)
  shop        Shop?          @relation(fields: [shopId], references: [id])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("additional_prices")
  // a label is unique per product / sub-product / shop (service also checks, since NULLs repeat)
  @@unique([productId, subProductId, shopId, label])
}

model ProductBatch {
  id              String          @id @default(uuid()) @map("_id") @db.Char(36)
  batchNumber     String             @unique 
  expiryDate      DateTime?
    productId       String       @db.Char(36)
  subProductId    String?      @db.Char(36)
  subProduct      SubProduct?  @relation(fields: [subProductId], references: [id], onDelete: Restrict)

  price           Decimal? @db.Decimal(14, 2)        @default(0)     // Base price for this batch
  // Relations
  storeId         String?      @db.Char(36)
  store           Store?       @relation(fields: [storeId], references: [id])
  product         Product      @relation(fields: [productId], references: [id])



  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([productId, expiryDate])
  @@map("product_batches")
  ShopStock ShopStock[]
  StoreStock StoreStock[]
  StockLedger StockLedger[]
  PurchaseItem PurchaseItem[]
  TransferItem TransferItem[]
  StockCorrectionItem StockCorrectionItem[]
  SellItemBatch SellItemBatch[]
  SellStockCorrectionBatch SellStockCorrectionBatch[]
}






model Purchase {
  id             String           @id @default(uuid()) @map("_id") @db.Char(36)
  invoiceNo      String           @unique                      // Invoice number
  supplierId     String           @db.Char(36)
  supplier       Supplier         @relation(fields: [supplierId], references: [id])
  storeId        String           @db.Char(36)
  store          Store            @relation(fields: [storeId], references: [id])

  // Goods receipt: PENDING until staff receive it (stock booked in) or reject it
  status         PurchaseStatus         @default(PENDING)
  // Supplier payment, independent of receipt; derived from amountPaid vs grandTotal
  paymentStatus  PurchasePaymentStatus  @default(UNPAID)
  amountPaid     Decimal @db.Decimal(14, 2)      @default(0)

  totalProducts  Int              @default(0)                  // number of different items
  subTotal       Decimal @db.Decimal(14, 2)            @default(0)
  grandTotal     Decimal @db.Decimal(14, 2)            @default(0)

  notes          String?
  purchaseDate   DateTime         @default(now())
  
  createdBy User?          @relation(fields: [createdById], references: [id], name: "creator")
  createdById          String?        @db.Char(36)
   updatedById           String?   @db.Char(36)
updatedBy             User?     @relation("UpdatedCheckEntrance", fields: [updatedById], references: [id])


  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  items          PurchaseItem[]

  @@index([purchaseDate])
  @@index([status])
  @@map("purchases")
  StockCorrection StockCorrection[]
}
model PurchaseItem {
  id          String             @id @default(uuid()) @map("_id") @db.Char(36)
  purchaseId  String          @db.Char(36)
  purchase    Purchase        @relation(fields: [purchaseId], references: [id])

  productId   String          @db.Char(36)
  product     Product         @relation(fields: [productId], references: [id])
  subProductId    String?      @db.Char(36)
  subProduct      SubProduct?  @relation(fields: [subProductId], references: [id], onDelete: Restrict)

  batchId     String
  batch       ProductBatch    @relation(fields: [batchId], references: [id])
  
  // ✅ Link directly to a single unit of measure
  unitOfMeasureId String
  unitOfMeasure   UnitOfMeasure @relation(fields: [unitOfMeasureId], references: [id])
  quantity    Int
  unitPrice   Decimal @db.Decimal(14, 2)           @default(0)
  totalPrice  Decimal @db.Decimal(14, 2)           @default(0)
  // Position of the line on the purchase as entered (0-based)
  lineNo      Int             @default(0)

  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  @@unique([purchaseId, batchId]) // one line per product / sub-product / batch
  @@map("purchase_items")
}
enum PurchaseStatus {
  PENDING
  RECEIVED
  REJECTED
}

enum PurchasePaymentStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
}

enum TaxType {
  PERCENT
  FIXED
}

enum DiscountType {
  PERCENT
  FIXED
}

enum TransferStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum TransferEntityType {
  STORE
  SHOP
}

model Transfer {
  id              String           @id @default(uuid()) @map("_id") @db.Char(36)
  shortCode      String          @unique                 // Invoice number

  // Source
  sourceType      TransferEntityType
  sourceStoreId   String? @db.Char(36)
  sourceStore     Store?  @relation("TransferSourceStore", fields: [sourceStoreId], references: [id], onDelete: Restrict)
  sourceShopId    String? @db.Char(36)
  sourceShop      Shop?   @relation("TransferSourceShop", fields: [sourceShopId], references: [id], onDelete: Restrict)

  // Destination
  destinationType TransferEntityType
  destStoreId     String? @db.Char(36)
  destStore       Store?  @relation("TransferDestinationStore", fields: [destStoreId], references: [id], onDelete: Restrict)
  destShopId      String? @db.Char(36)
  destShop        Shop?   @relation("TransferDestinationShop", fields: [destShopId], references: [id], onDelete: Restrict)

  // Transfer details
  reference       String?       // optional transfer reference code
  notes           String?
  status          TransferStatus @default(PENDING)
  movementDate    DateTime @default(now())

  createdById     String? @db.Char(36)
  createdBy       User?   @relation("createdTransfer",fields: [createdById], references: [id])
updatedById           String?   @db.Char(36)
updatedBy             User?     @relation("UpdatedTransfer", fields: [updatedById], references: [id])

  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  items           TransferItem[]
  
  @@index([status, createdAt])
  @@map("transfers")
  StockCorrection StockCorrection[]
}

model TransferItem {
  id            String        @id @default(uuid()) @map("_id") @db.Char(36)
  transferId    String        @db.Char(36)
  transfer      Transfer      @relation(fields: [transferId], references: [id])

  productId     String        @db.Char(36)
  product       Product       @relation(fields: [productId], references: [id])
  subProductId    String?      @db.Char(36)
  subProduct      SubProduct?  @relation(fields: [subProductId], references: [id], onDelete: Restrict)

  batchId       String
  batch         ProductBatch  @relation(fields: [batchId], references: [id])

  // ✅ Link directly to a single unit of measure
  unitOfMeasureId String
  unitOfMeasure   UnitOfMeasure @relation(fields: [unitOfMeasureId], references: [id])

  quantity      Int

  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@unique([transferId, batchId]) // one line per product / sub-product / batch
  @@map("transfer_items")
}

// ======================= ENUMS ======================= //

enum StockCorrectionReason {
  PURCHASE_ERROR
  TRANSFER_ERROR
  EXPIRED
  DAMAGED
  MANUAL_ADJUSTMENT
}

enum StockCorrectionStatus {
  PENDING
  APPROVED
  REJECTED
}

model StockCorrection {
  id            String              @id @default(uuid()) @map("_id") @db.Char(36)
  shortCode      String          @unique                 // Invoice number

  storeId       String? @db.Char(36)
  store         Store?  @relation(fields: [storeId], references: [id], onDelete: Restrict)

  shopId        String? @db.Char(36)
  shop          Shop?   @relation(fields: [shopId], references: [id], onDelete: Restrict)
  // correction details
  reason           StockCorrectionReason
  status           StockCorrectionStatus @default(PENDING)

  // optional linkage to original source document
  purchaseId     String? @db.Char(36)
  purchase       Purchase? @relation(fields: [purchaseId], references: [id])

  transferId     String? @db.Char(36)
  transfer       Transfer? @relation(fields: [transferId], references: [id])

  reference        String?           // Optional reference number for tracking
  notes            String?

  createdById      String? @db.Char(36)
  createdBy        User?   @relation("createdStockCorrection", fields: [createdById], references: [id])
  updatedById      String? @db.Char(36)
  updatedBy        User?   @relation("updatedStockCorrection", fields: [updatedById], references: [id])

  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  items            StockCorrectionItem[]

  @@index([status, createdAt])
  @@map("stock_corrections")
}

model StockCorrectionItem {
  id             String        @id @default(uuid()) @map("_id") @db.Char(36)
  correctionId   String        @db.Char(36)
  correction     StockCorrection @relation(fields: [correctionId], references: [id])

  productId      String        @db.Char(36)
  product        Product       @relation(fields: [productId], references: [id])
  subProductId    String?      @db.Char(36)
  subProduct      SubProduct?  @relation(fields: [subProductId], references: [id], onDelete: Restrict)

  batchId        String
  batch          ProductBatch  @relation(fields: [batchId], references: [id])

  unitOfMeasureId String
  unitOfMeasure   UnitOfMeasure @relation(fields: [unitOfMeasureId], references: [id])

  quantity       Int            // Allow both positive and negative values


  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@unique([correctionId, batchId]) // one line per product / sub-product / batch
  @@map("stock_correction_items")
}
// Where a sale was created: in this system (POS, sales app) or from an
// online order confirmed in the e-commerce system
enum SaleSource {
  STOCK
  ECOMMERCE
}

enum SaleStatus { 
  NOT_APPROVED
  PARTIALLY_DELIVERED 
  APPROVED 
  DELIVERED
  CANCELLED
  RETURNED
}

model Sell {
  id             String          @id @default(uuid()) @map("_id") @db.Char(36)
  invoiceNo      String          @unique
  saleStatus     SaleStatus      @default(NOT_APPROVED)
 locked         Boolean         @default(false)
 lockedAt       DateTime?
  branchId       String?
  branch         Branch ?         @relation(fields: [branchId], references: [id])

  customerId     String?         @db.Char(36)
  customer       Customer?       @relation(fields: [customerId], references: [id])

  totalProducts  Int             @default(0)
  subTotal       Decimal @db.Decimal(14, 2)           @default(0)
  discount       Decimal @db.Decimal(14, 2)           @default(0)
  vat            Decimal @db.Decimal(14, 2)           @default(0)
  grandTotal     Decimal @db.Decimal(14, 2)           @default(0)
  NetTotal       Decimal @db.Decimal(14, 2)           @default(0)

  notes          String?
  saleDate       DateTime        @default(now())

  createdById    String?         @db.Char(36)
  createdBy      User?           @relation("CreatedSale", fields: [createdById], references: [id])
  updatedById    String?         @db.Char(36)
  updatedBy      User?           @relation("UpdatedSale", fields: [updatedById], references: [id])

  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  items          SellItem[]

  // Online orders: the e-commerce order id (unique, so a repeated message can
  // never create a second sale) and its human-readable order number
  source              SaleSource @default(STOCK)
  externalOrderId     String?    @unique @map("external_order_id") @db.VarChar(64)
  externalOrderNumber String?    @map("external_order_number") @db.VarChar(64)

  @@index([saleStatus, saleDate])
  @@index([source, saleDate])
  @@index([createdById, saleDate])
  @@map("sells")
  SellStockCorrection SellStockCorrection[]
  onlineOrder OnlineOrder?
}

model SellItem {
  id               String          @id @default(uuid()) @map("_id") @db.Char(36)
  sellId           String          @db.Char(36)
  sell             Sell            @relation(fields: [sellId], references: [id])
  
  productId        String          @db.Char(36)
  product          Product         @relation(fields: [productId], references: [id])
  subProductId    String?      @db.Char(36)
  subProduct      SubProduct?  @relation(fields: [subProductId], references: [id], onDelete: Restrict)

  shopId           String          @db.Char(36)
  shop             Shop            @relation(fields: [shopId], references: [id])

  unitOfMeasureId  String
  unitOfMeasure    UnitOfMeasure   @relation(fields: [unitOfMeasureId], references: [id])

  itemSaleStatus   ItemSaleStatus  @default(PENDING)

  quantity         Int
  unitPrice        Decimal @db.Decimal(14, 2)           @default(0)
  totalPrice       Decimal @db.Decimal(14, 2)           @default(0)

  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  batches          SellItemBatch[]

  @@map("sell_items")
}

model SellItemBatch {
  id           String         @id @default(uuid()) @map("_id") @db.Char(36)
  sellItemId   String         @db.Char(36)
  sellItem     SellItem       @relation(fields: [sellItemId], references: [id])

  batchId      String         @db.Char(36)
  batch        ProductBatch   @relation(fields: [batchId], references: [id])

  quantity     Int            @default(0) // Quantity taken from this batch

  @@unique([sellItemId, batchId])
  @@map("sell_item_batches")
}





// ==============================
// 🛒 ADD TO CART MODELS
// ==============================

model AddToCart {
  id           String       @id @default(uuid()) @map("_id") @db.Char(36)
  
  userId       String       @db.Char(36)
  user         User         @relation(fields: [userId], references: [id])
  
  branchId     String?
  branch       Branch?      @relation(fields: [branchId], references: [id])
  isCheckedOut Boolean      @default(false)    // true when converted into a Sell
  isWaitlist   Boolean   @default(false)    // true = in wait list
  discount     Decimal @db.Decimal(14, 2)    @default(0)  // Make sure this line exists exactly like this
    notes          String?

  customerId       String?       @db.Char(36)
  customer         Customer?     @relation(fields: [customerId], references: [id])
  totalItems   Int          @default(0)
  totalAmount  Decimal @db.Decimal(14, 2)        @default(0)

 createdById    String?         @db.Char(36)
  createdBy      User?           @relation("CreatedCart", fields: [createdById], references: [id])
  updatedById    String?         @db.Char(36)
  updatedBy      User?           @relation("UpdatedCart", fields: [updatedById], references: [id])
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  items        CartItem[]
  
  @@map("add_to_carts")
  waitlists Waitlist[]
}

model CartItem {
  id              String          @id @default(uuid()) @map("_id") @db.Char(36)
  cartId          String          @db.Char(36)
  cart            AddToCart       @relation(fields: [cartId], references: [id])
  isWaitlist   Boolean   @default(false)    // true = in wait list

  shopId          String          @db.Char(36)
  shop            Shop            @relation(fields: [shopId], references: [id])   // 🆕 Added shop relation

  productId       String
  product         Product         @relation(fields: [productId], references: [id])
    subProductId    String?      @db.Char(36)
  subProduct      SubProduct?  @relation(fields: [subProductId], references: [id])

  unitOfMeasureId String?
  unitOfMeasure   UnitOfMeasure?  @relation(fields: [unitOfMeasureId], references: [id])

  quantity        Int
  unitPrice       Decimal @db.Decimal(14, 2)           @default(0)
  totalPrice      Decimal @db.Decimal(14, 2)           @default(0)
  
  notes           String?

  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  @@map("cart_items")
  waitlists Waitlist[]
}
model Waitlist {
  id           String       @id @default(uuid()) @map("_id") @db.Char(36)

  userId       String?      @db.Char(36)
  user         User?        @relation(fields: [userId], references: [id])

  customerId   String?      @db.Char(36)
  customer     Customer?    @relation(fields: [customerId], references: [id])

  branchId     String?      @db.Char(36)
  branch       Branch?      @relation(fields: [branchId], references: [id])

  // Links to the cart this waitlist belongs to
  cartId       String?      @db.Char(36)
  cart         AddToCart?   @relation(fields: [cartId], references: [id])

  // Optional: link to a specific CartItem being waitlisted
  cartItemId   String?      @db.Char(36)
  cartItem     CartItem?    @relation(fields: [cartItemId], references: [id])

  productId    String?      @db.Char(36)
  product      Product?     @relation(fields: [productId], references: [id])

  quantity     Int          @default(1)
  note         String?
  shopId       String?      @db.Char(36)
  shop         Shop?        @relation(fields: [shopId], references: [id])

  createdById  String?      @db.Char(36)
  createdBy    User?        @relation("CreatedWaitlist", fields: [createdById], references: [id])
  updatedById  String?      @db.Char(36)
  updatedBy    User?        @relation("UpdatedWaitlist", fields: [updatedById], references: [id])

  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  @@map("waitlists")
}




enum SellStockCorrectionStatus {
  PENDING
  APPROVED
  PARTIAL
  REJECTED
}
enum ItemSaleStatus {
  PENDING
  DELIVERED
  REJECTED
  CANCELLED
  RETURNED
}
model SellStockCorrection {
  id          String                     @id @default(uuid()) @map("_id") @db.Char(36)
  sellId      String?                    @db.Char(36)
  sell        Sell?                      @relation(fields: [sellId], references: [id])
  isChecked Boolean? @default(false) 
  isCh Boolean? @default(false) // Make sure this field exists

  status      SellStockCorrectionStatus  @default(PENDING)

  reference   String?                    // Optional reference number for tracking
  notes       String?

  createdById String?                    @db.Char(36)
  createdBy   User?                      @relation("createdSellStockCorrection", fields: [createdById], references: [id])
  updatedById String?                    @db.Char(36)
  updatedBy   User?                      @relation("updatedSellStockCorrection", fields: [updatedById], references: [id])
  total     Decimal @db.Decimal(14, 2)           @default(0)
  createdAt   DateTime                   @default(now()) @map("created_at")
  updatedAt   DateTime                   @updatedAt @map("updated_at")

  items       SellStockCorrectionItem[]

  @@index([status, createdAt])
  @@map("sell_stock_corrections")
}

model SellStockCorrectionItem {
  id               String                    @id @default(uuid()) @map("_id") @db.Char(36)

  correctionId     String                    @db.Char(36)
  correction       SellStockCorrection       @relation(fields: [correctionId], references: [id])

  productId        String                    @db.Char(36)
  product          Product                   @relation(fields: [productId], references: [id])
  subProductId    String?      @db.Char(36)
  subProduct      SubProduct?  @relation(fields: [subProductId], references: [id], onDelete: Restrict)

  shopId           String?                   @db.Char(36)
  shop             Shop?                     @relation(fields: [shopId], references: [id], onDelete: Restrict)

  unitOfMeasureId  String                    @db.Char(36)
  unitOfMeasure    UnitOfMeasure             @relation(fields: [unitOfMeasureId], references: [id])

  quantity         Int                        // Can be positive or negative
  unitPrice        Decimal @db.Decimal(14, 2)                      @default(0)
  totalPrice       Decimal @db.Decimal(14, 2)                      @default(0)
  itemSaleStatus   ItemSaleStatus  @default(PENDING)

  createdAt        DateTime                   @default(now()) @map("created_at")
  updatedAt        DateTime                   @updatedAt @map("updated_at")

  batches          SellStockCorrectionBatch[]

  @@map("sell_stock_correction_items")
}
model SellStockCorrectionBatch {
  id                 String              @id @default(uuid()) @map("_id") @db.Char(36)

  correctionItemId   String              @db.Char(36)
  correctionItem     SellStockCorrectionItem @relation(fields: [correctionItemId], references: [id])

  batchId            String              @db.Char(36)
  batch              ProductBatch        @relation(fields: [batchId], references: [id])

  quantity           Int                 @default(0)

  @@unique([correctionItemId, batchId])
  @@map("sell_stock_correction_batches")
}



// An order placed in the e-commerce shop, waiting here until store management
// chooses which shop each line goes out from. Then it becomes a normal Sell
// (source ECOMMERCE) and follows the usual approve / deliver steps. Kept apart
// from Sell because every sale line must have a shop.
enum OnlineOrderStatus {
  NEW       // received, shops not all chosen yet
  CONVERTED // became a Sell (sellId)
  CANCELLED // cancelled in the e-commerce shop before it became a sale
}

model OnlineOrder {
  id                  String            @id @default(uuid()) @map("_id") @db.Char(36)
  // E-commerce order id (unique: a repeated message can't add the order twice)
  externalOrderId     String            @unique @map("external_order_id") @db.VarChar(64)
  externalOrderNumber String            @map("external_order_number") @db.VarChar(64)
  status              OnlineOrderStatus @default(NEW)

  // Customer as matched / created in stock, plus what the shop sent
  customerId    String?   @map("customer_id") @db.Char(36)
  customer      Customer? @relation(fields: [customerId], references: [id])
  customerName  String    @map("customer_name") @db.VarChar(255)
  customerPhone String?   @map("customer_phone") @db.VarChar(50)
  companyName   String?   @map("company_name") @db.VarChar(255)
  tinNumber     String?   @map("tin_number") @db.VarChar(100)

  // Totals as the customer was charged (after tier discounts)
  subtotal      Decimal @db.Decimal(14, 2)
  discountTotal Decimal @default(0) @map("discount_total") @db.Decimal(14, 2)
  deliveryFee   Decimal @default(0) @map("delivery_fee") @db.Decimal(14, 2)
  totalAmount   Decimal @map("total_amount") @db.Decimal(14, 2)
  notes         String? @db.Text
  payload       Json // the message exactly as received, for reference

  // The sale it became
  sellId        String?   @unique @map("sell_id") @db.Char(36)
  sell          Sell?     @relation(fields: [sellId], references: [id])
  convertedById String?   @map("converted_by_id") @db.Char(36)
  convertedBy   User?     @relation("ConvertedOnlineOrders", fields: [convertedById], references: [id])
  convertedAt   DateTime? @map("converted_at")
  cancelledAt   DateTime? @map("cancelled_at")

  receivedAt DateTime @default(now()) @map("received_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  items OnlineOrderItem[]

  @@index([status, receivedAt])
  @@map("online_orders")
}

model OnlineOrderItem {
  id            String      @id @default(uuid()) @map("_id") @db.Char(36)
  onlineOrderId String      @map("online_order_id") @db.Char(36)
  onlineOrder   OnlineOrder @relation(fields: [onlineOrderId], references: [id], onDelete: Cascade)
  lineNo        Int         @default(0) @map("line_no")

  productId    String      @map("product_id") @db.Char(36)
  product      Product     @relation(fields: [productId], references: [id])
  subProductId String?     @map("sub_product_id") @db.Char(36)
  subProduct   SubProduct? @relation(fields: [subProductId], references: [id])

  quantity   Int
  unitPrice  Decimal @map("unit_price") @db.Decimal(14, 2) // after discount
  totalPrice Decimal @map("total_price") @db.Decimal(14, 2)

  // Chosen by store management before the order becomes a sale
  shopId String? @map("shop_id") @db.Char(36)
  shop   Shop?   @relation(fields: [shopId], references: [id])

  @@index([onlineOrderId])
  @@map("online_order_items")
}

// Messages for the e-commerce system (e.g. a product was created or changed),
// written in the same transaction as the change and sent by a job, so saving
// in stock never fails because the online shop is down. Failed sends stay
// PENDING and are retried from nextAttemptAt.
enum OutboxStatus {
  PENDING
  SENT
  FAILED
}

model IntegrationOutbox {
  id            String       @id @default(uuid()) @map("_id") @db.Char(36)
  type          String       @db.VarChar(64) // e.g. "product.upsert"
  aggregateId   String?      @map("aggregate_id") @db.Char(36) // record the message is about
  payload       Json
  status        OutboxStatus @default(PENDING)
  attempts      Int          @default(0)
  lastError     String?      @map("last_error") @db.Text
  nextAttemptAt DateTime     @default(now()) @map("next_attempt_at")
  sentAt        DateTime?    @map("sent_at")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  @@index([status, nextAttemptAt])
  @@index([type, aggregateId])
  @@map("integration_outbox")
}

model Notification {
  id                String @id @default(uuid()) @map("_id") @db.Char(36)
  title             String
  message           String
  type              NotificationType
  read              Boolean            @default(false)
  relatedEntityType RelatedEntityType?
  relatedEntityId   String?             @db.Char(36)
  createdAt         DateTime           @default(now()) @map("created_at")
  readAt            DateTime?          @map("read_at")
   storeId     String?           @db.Char(36)
  store       Store?            @relation(fields: [storeId], references: [id])

  shopId      String?           @db.Char(36)
  shop        Shop?             @relation(fields: [shopId], references: [id])

  @@index([ read])
  @@map("notifications")
}





enum DocumentType {
  CONTRACT
  CV
  REPORT
  CERTIFICATE
  ID_CARD
  PASSPORT
  LICENSE
  OTHER
  Lease
}

enum NotificationType {
SELL_READY_FOR_DELIVERY
SELL_CANCELLED
Done

Payment
Inventory
System
Approval

}

enum RelatedEntityType {
 SELL
 MaintenanceRequest
 Invoice
 PurchaseOrder
 InventoryRequest
 
}
